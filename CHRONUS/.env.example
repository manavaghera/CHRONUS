# Copy to CHRONUS/.env (gitignored) and fill in what you use. Every line is
# optional; config.py has the defaults. Real environment variables win over
# this file.

# ---- AI voice (natural mode) ----
# OpenRouter / OpenAI-compatible key. Without it, answers use verbatim quotes.
OPENAI_API_KEY=
# "openrouter" (default), "openai", "ollama", or "local" (on-device model, no cloud)
CHRONUS_LLM_PROVIDER=openrouter
# CHRONUS_OPENAI_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# CHRONUS_OPENAI_BASE_URL=https://openrouter.ai/api/v1

# ---- Cloned voices for custom models (Fish Audio, fish.audio/app/api-keys) ----
FISH_API_KEY=

# ---- Server ----
# Loopback by default. Binding anything else exposes the server: set an access code.
# CHRONUS_HOST=127.0.0.1
# CHRONUS_PORT=8001
# Host names the server answers to (add your LAN name or domain when hosting)
# CHRONUS_ALLOWED_HOSTS=localhost,127.0.0.1,::1
# Passcode for the whole API and website; empty = no sign-in
# CHRONUS_ACCESS_CODE=
# Chat/voice requests per client per minute (0 = no limit)
# CHRONUS_RATE_LIMIT=30
# Days to keep questions/answers and feedback (0 = keep forever)
# CHRONUS_LOG_RETENTION_DAYS=90
# Answer repeated questions from a one-hour cache (0 = off)
# CHRONUS_ANSWER_CACHE=1

# ---- Retrieval experiments (measure with: python -m evaluation.run_eval) ----
# "dense" (default) or "hybrid" (semantic + BM25 keyword search)
# CHRONUS_RETRIEVAL_MODE=dense
# Largest distance bonus an important memory gets (0 = rank by meaning only)
# CHRONUS_IMPORTANCE_WEIGHT=0.08
# Cross-encoder reranker, e.g. cross-encoder/ms-marco-MiniLM-L-6-v2 (downloads ~90 MB)
# CHRONUS_RERANKER_MODEL=
# Sentence-level grounding guard for AI-voice answers (0 = off; try 0.67)
# CHRONUS_MIN_SEMANTIC_SUPPORT=0

# ---- Storage ----
# CHRONUS_CHROMA_PATH=./chroma_db
